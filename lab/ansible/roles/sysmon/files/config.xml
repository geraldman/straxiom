<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>
  <DnsLookup>False</DnsLookup>

  <EventFiltering>

    <!-- Event 1: log ALL process creation (process chains, UEBA parent-child) -->
    <RuleGroup name="proc-create" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
    </RuleGroup>

    <!-- Event 3: log ALL network connections (beaconing, lateral movement) -->
    <RuleGroup name="net-connect" groupRelation="or">
      <NetworkConnect onmatch="exclude" />
    </RuleGroup>

    <!-- Event 5: explicitly OFF. Empty include = log nothing -->
    <RuleGroup name="proc-terminate-off" groupRelation="or">
      <ProcessTerminate onmatch="include" />
    </RuleGroup>

    <!-- Event 11: file creation, only in paths tied to planned rules -->
    <RuleGroup name="file-persistence" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="technique_id=T1053.003,technique_name=Cron" condition="begin with">/etc/cron</TargetFilename>
        <TargetFilename name="technique_id=T1053.003,technique_name=Cron" condition="begin with">/var/spool/cron</TargetFilename>
        <TargetFilename name="technique_id=T1543.002,technique_name=Systemd Service" condition="begin with">/etc/systemd/system</TargetFilename>
        <TargetFilename name="technique_id=T1098.004,technique_name=SSH Authorized Keys" condition="contains">/.ssh/</TargetFilename>
        <TargetFilename name="technique_id=T1105,technique_name=Ingress Tool Transfer" condition="begin with">/tmp/</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Event 100 (Linux-only): eBPF program loaded. Low volume, covers eBPF abuse -->
    <RuleGroup name="ebpf-load" groupRelation="or">
      <eBPFEvent onmatch="exclude" />
    </RuleGroup>

  </EventFiltering>
</Sysmon>