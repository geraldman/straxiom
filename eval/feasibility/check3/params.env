# Check 3 run parameters: the single place to tune the run.
# Meaning of each value: docs/feasibility.md (Check 3).
#
# NO SECRETS IN THIS FILE. It is committed on purpose: the commit history proves
# the thresholds were fixed before the run. Credentials go in .env (gitignored).
# Changing a threshold after a run starts invalidates that run.
# Shell-sourceable: `set -a; . ./params.env; set +a`

# --- Hosts ---
STACK_IP=192.168.100.10
VICTIM_IP=192.168.100.21
OPENOBSERVE_PORT=5080

# --- Timing ---
WARMUP_MIN=5
LOAD_MIN=15
SAMPLE_INTERVAL_S=5          # vmstat, iostat and Get-Counter sample interval

# --- Load: failed SSH logins (stack -> victim) ---
SSH_FAIL_USER=straxiom-nouser
SSH_FAIL_SLEEP_S=1           # sleep between attempts; real rate is lower, record the actual count
SSH_CONNECT_TIMEOUT_S=3

# --- Load: normal activity loop (on the victim) ---
ACTIVITY_INTERVAL_S=10
ACTIVITY_TMP_PREFIX=/tmp/straxiom-activity-

# --- Ingest latency markers ---
MARKER_COUNT=5
CLOCK_MAX_OFFSET_MS=100      # victim vs. stack, from chronyc tracking, checked before the run
MARKER_SPACING_S=180         # spread across the load window (minutes 1, 4, 7, 10, 13) to avoid a false pass

# --- Pass criteria ---
HOST_MIN_AVAILABLE_MB=1500
SWAP_MAX_NONZERO_SAMPLES=1   # per guest, isolated, across the load window

# --- Tripwires ---
LATENCY_MAX_S=20
DISK_W_AWAIT_MAX_MS=50
DISK_W_AWAIT_CONSECUTIVE=3
